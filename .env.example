# 9router Configuration

# Temp Email Configuration
TEMP_EMAIL_DOMAIN=xyntaur.com
TEMP_EMAIL_BASE_URL=https://tempik.neroism.web.id

# OpenRouter URLs
OPENROUTER_SIGNUP_URL=https://openrouter.ai/sign-up
OPENROUTER_KEYS_URL=https://openrouter.ai/workspaces/default/keys
OPENROUTER_API_KEY_ENDPOINT=https://openrouter.ai/api/v1/auth/key

# Browser Configuration
HEADLESS=false
BROWSER_TIMEOUT=60000

# Rate Limiting (ms between account creations)
DELAY_BETWEEN_ACCOUNTS=5000

# --- 9router REST API (replaces direct DB writes) ---
NINEROUTER_BASE_URL=http://localhost:20128
NINEROUTER_AUTH_TOKEN=
# Leave AUTH_TOKEN empty to auto-mint from %APPDATA%/9router/jwt-secret (recommended).
# Or set the dashboard password so it refreshes via /api/auth/login:
NINEROUTER_PASSWORD=
